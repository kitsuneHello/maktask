<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="maktask.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:maktask"
    xmlns:views="using:maktask.Views"
    xmlns:vm="using:maktask.ViewModels"
    xmlns:converters="using:maktask.Converters"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Animation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MakTask">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <converters:ColorStringToBrushConverter x:Key="ColorToBrushConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左サイドバー: プロジェクト一覧（常に表示） -->
        <Grid Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー領域（ドラッグ可能） -->
            <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="12,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="24" Height="24"/>
                    <TextBlock Text="MakTask" FontWeight="SemiBold" FontSize="18" 
                               VerticalAlignment="Center" Foreground="#333333"/>
                </StackPanel>
            </Grid>

            <!-- プロジェクトヘッダー -->
            <TextBlock Grid.Row="1" Text="プロジェクト" 
                       FontSize="13" FontWeight="SemiBold" Foreground="#666666"
                       Margin="16,8,16,8"/>

            <!-- プロジェクトリスト -->
            <ListView Grid.Row="2" x:Name="ProjectListView"
                      SelectionMode="Single" Padding="8,0"
                      Background="Transparent"
                      IsItemClickEnabled="True"
                      ItemClick="ProjectListView_ItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="MinHeight" Value="36"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectViewModel">
                        <Grid Padding="8,6" ColumnSpacing="10" 
                              Background="Transparent" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="編集" Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="削除" Tag="{x:Bind}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{x:Bind Project.UIColor}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{x:Bind Project.Name}" 
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="13" Foreground="#333333"/>
                            <!-- トグルスイッチ: ホームタブ時のみ表示 -->
                            <ToggleSwitch Grid.Column="2" x:Name="VisibilityToggle"
                                          IsOn="{x:Bind IsVisible, Mode=TwoWay}" 
                                          MinWidth="0" MinHeight="0" 
                                          OnContent="" OffContent=""
                                          Margin="0" Padding="0"
                                          Visibility="Collapsed"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- プロジェクト新規作成ボタン -->
            <Button Grid.Row="3" Content="＋ プロジェクト作成" 
                    Margin="12,8,12,16" Padding="12,10"
                    HorizontalAlignment="Stretch"
                    Background="#FFFFFF" Foreground="#333333"
                    BorderBrush="#D0D0D0" BorderThickness="1"
                    CornerRadius="6"
                    Click="CreateProject_Click"/>
        </Grid>

        <!-- メインコンテンツ: タブエリア -->
        <TabView Grid.Column="1" x:Name="MainTabView" 
                 AddTabButtonClick="TabView_AddTabButtonClick"
                 TabCloseRequested="TabView_TabCloseRequested"
                 SelectionChanged="TabView_SelectionChanged"
                 IsAddTabButtonVisible="False"
                 VerticalAlignment="Stretch"
                 Background="#FAFAFA">
            <TabView.Resources>
                <media:EntranceThemeTransition x:Key="TabContentTransition"/>
            </TabView.Resources>
        </TabView>
    </Grid>
</Window>
