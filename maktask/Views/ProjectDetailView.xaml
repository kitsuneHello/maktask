<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="maktask.Views.ProjectDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:maktask.Views"
    xmlns:models="using:maktask.Models"
    xmlns:converters="using:maktask.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ColorStringToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:DateTimeToStringConverter x:Key="DateTimeToString"/>
    </UserControl.Resources>

    <ScrollViewer Background="#FAFAFA" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center">
            <StackPanel Padding="40" Width="700" Spacing="24">
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Ellipse Width="24" Height="24" 
                                 Fill="{x:Bind ViewModel.ThemeColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"/>
                        <TextBlock Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" 
                                   FontSize="24" FontWeight="SemiBold" Foreground="#333333"
                                   Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                        <TextBox Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                 MinWidth="200" Background="#FFFFFF" BorderBrush="#E0E0E0" CornerRadius="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="編集" Click="StartEdit_Click" Padding="16,8" CornerRadius="6"
                                Background="#F0F0F0" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                        <Button Content="保存" Click="SaveEdit_Click" Padding="16,8" CornerRadius="6"
                                Background="#0078D4" Foreground="White" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="キャンセル" Click="CancelEdit_Click" Padding="16,8" CornerRadius="6"
                                Background="#F0F0F0" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <!-- Color Selection (Edit Mode) -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1"
                        Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="テーマカラー" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#0078D4" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#0078D4"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                            <Border Background="#E81123" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#E81123"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                            <Border Background="#107C10" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#107C10"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                            <Border Background="#FF8C00" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#FF8C00"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                            <Border Background="#5C2D91" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#5C2D91"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                            <Border Background="#00B7C3" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#00B7C3"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                            <Border Background="#E3008C" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#E3008C"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                            <Border Background="#767676" Width="36" Height="36" CornerRadius="18" 
                                    Tapped="ColorBorder_Tapped" Tag="#767676"
                                    PointerEntered="ColorBorder_PointerEntered" PointerExited="ColorBorder_PointerExited"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tasks Section -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="タスク一覧" FontSize="13" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="＋ タスク追加" Click="CreateTask_Click"
                                    Padding="12,8" CornerRadius="6" Background="#0078D4" Foreground="White" BorderThickness="0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItem">
                                    <Border Background="#F8F8F8" CornerRadius="6" Margin="0,4" Padding="14,10"
                                            BorderBrush="#E8E8E8" BorderThickness="1"
                                            PointerPressed="TaskItem_PointerPressed" RightTapped="TaskItem_RightTapped">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="削除" Icon="Delete" Click="DeleteTask_Click"/>
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Foreground="#333333"/>
                                            <TextBlock Grid.Column="1" Foreground="#999999" VerticalAlignment="Center" FontSize="12">
                                                <Run Text="{x:Bind StartDateTime, Converter={StaticResource DateTimeToString}, ConverterParameter='M/d'}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{x:Bind EndDateTime, Converter={StaticResource DateTimeToString}, ConverterParameter='M/d'}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="タスクがありません" Foreground="#999999" FontSize="13"
                                   Visibility="{x:Bind HasNoTasks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
