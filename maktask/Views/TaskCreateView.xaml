<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="maktask.Views.TaskCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:maktask.Views"
    xmlns:vm="using:maktask.ViewModels"
    xmlns:converters="using:maktask.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer Background="#FAFAFA" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center">
            <StackPanel Padding="40" Width="700" Spacing="24">
                <TextBlock Text="タスク作成" FontSize="24" FontWeight="SemiBold" Foreground="#333333"/>

            <!-- Project Selection -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="プロジェクト" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                              Background="#FFFFFF" BorderBrush="#E0E0E0" CornerRadius="6"/>
                </StackPanel>
            </Border>

            <!-- Task Name -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="タスク名" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>
                    <TextBox Text="{x:Bind ViewModel.TaskName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="タスク名を入力"
                             Background="#FAFAFA" BorderBrush="#E0E0E0" CornerRadius="6" Padding="12"/>
                </StackPanel>
            </Border>

            <!-- Date Settings -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="期間設定" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>

                    <!-- 開始日時（期限モードOFF時のみ表示） -->
                    <Grid ColumnSpacing="12"
                          Visibility="{x:Bind ViewModel.IsDeadlineMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="開始日" FontSize="12" Opacity="0.7"/>
                            <CalendarDatePicker Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4"
                                    Visibility="{x:Bind ViewModel.IsAllDay, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="開始時刻" FontSize="12" Opacity="0.7"/>
                            <TimePicker Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}" MinWidth="100"/>
                        </StackPanel>
                    </Grid>

                    <!-- 終了日時 / 期限 -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Opacity="0.7">
                                <Run Text="{x:Bind ViewModel.EndDateLabel, Mode=OneWay}"/>
                            </TextBlock>
                            <CalendarDatePicker Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4"
                                    Visibility="{x:Bind ViewModel.IsAllDay, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock FontSize="12" Opacity="0.7">
                                <Run Text="{x:Bind ViewModel.EndTimeLabel, Mode=OneWay}"/>
                            </TextBlock>
                            <TimePicker Time="{x:Bind ViewModel.EndTime, Mode=TwoWay}" MinWidth="100"/>
                        </StackPanel>
                    </Grid>

                    <!-- トグル -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch Header="終日" IsOn="{x:Bind ViewModel.IsAllDay, Mode=TwoWay}"
                                      OnContent="ON" OffContent="OFF"/>
                        <ToggleSwitch Grid.Column="1" Header="期限モード" IsOn="{x:Bind ViewModel.IsDeadlineMode, Mode=TwoWay}"
                                      OnContent="ON" OffContent="OFF"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Subtasks -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="サブタスク" FontSize="13" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="＋ 追加" Click="AddSubtask_Click"
                                Padding="10,6" CornerRadius="4" Background="#F0F0F0" BorderThickness="0" FontSize="12"/>
                    </Grid>

                    <!-- サブタスク追加フォーム -->
                    <Border x:Name="AddSubtaskForm" Background="#F8F8F8" CornerRadius="6" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="サブタスク名" FontSize="12" Foreground="#666666"/>
                                <TextBox x:Name="NewSubtaskNameBox" PlaceholderText="サブタスク名を入力"
                                         Background="#FFFFFF" BorderBrush="#E0E0E0" CornerRadius="4" Padding="10"/>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Text="期間設定" FontSize="12" Foreground="#666666"/>

                                <!-- 開始日時（期限モードOFF時のみ表示） -->
                                <Grid x:Name="SubtaskStartDateGrid" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="開始日" FontSize="11" Opacity="0.7"/>
                                        <CalendarDatePicker x:Name="SubtaskStartDatePicker" HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel x:Name="SubtaskStartTimePanel" Grid.Column="1" Spacing="4" Visibility="Collapsed">
                                        <TextBlock Text="開始時刻" FontSize="11" Opacity="0.7"/>
                                        <TimePicker x:Name="SubtaskStartTimePicker" MinWidth="100"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 終了日時 / 期限 -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="SubtaskEndDateLabel" Text="終了日" FontSize="11" Opacity="0.7"/>
                                        <CalendarDatePicker x:Name="SubtaskEndDatePicker" HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel x:Name="SubtaskEndTimePanel" Grid.Column="1" Spacing="4" Visibility="Collapsed">
                                        <TextBlock x:Name="SubtaskEndTimeLabel" Text="終了時刻" FontSize="11" Opacity="0.7"/>
                                        <TimePicker x:Name="SubtaskEndTimePicker" MinWidth="100"/>
                                    </StackPanel>
                                </Grid>

                                <!-- トグル -->
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="SubtaskIsAllDayToggle" Header="終日" IsOn="True" 
                                                  OnContent="ON" OffContent="OFF" Toggled="SubtaskIsAllDayToggle_Toggled"/>
                                    <ToggleSwitch x:Name="SubtaskIsDeadlineModeToggle" Grid.Column="1" Header="期限モード" IsOn="False"
                                                  OnContent="ON" OffContent="OFF" Toggled="SubtaskIsDeadlineModeToggle_Toggled"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="キャンセル" Click="CancelAddSubtask_Click"
                                        Padding="12,6" CornerRadius="4" Background="#F0F0F0" BorderThickness="0"/>
                                <Button Content="追加" Click="ConfirmAddSubtask_Click"
                                        Padding="12,6" CornerRadius="4" Background="#0078D4" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- サブタスク一覧 -->
                    <StackPanel x:Name="SubtasksPanel"/>
                </StackPanel>
            </Border>

            <!-- Memo -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="メモ" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>
                    <TextBox Text="{x:Bind ViewModel.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                             PlaceholderText="メモを入力..."
                             Background="#FAFAFA" BorderBrush="#E0E0E0" CornerRadius="6" Padding="12"/>
                </StackPanel>
            </Border>

            <Button Content="作成" HorizontalAlignment="Left" MinWidth="120" Click="Create_Click"
                    Padding="16,10" CornerRadius="6" Background="#0078D4" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
