<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="maktask.Views.TaskCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:maktask.Views"
    xmlns:vm="using:maktask.ViewModels"
    xmlns:converters="using:maktask.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer Background="#FAFAFA" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center">
            <StackPanel Padding="40" Width="700" Spacing="24">
                <TextBlock Text="タスク作成" FontSize="24" FontWeight="SemiBold" Foreground="#333333"/>

            <!-- Project Selection -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="プロジェクト" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                              Background="#FFFFFF" BorderBrush="#E0E0E0" CornerRadius="6"/>
                </StackPanel>
            </Border>

            <!-- Task Name -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="タスク名" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>
                    <TextBox Text="{x:Bind ViewModel.TaskName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="タスク名を入力"
                             Background="#FAFAFA" BorderBrush="#E0E0E0" CornerRadius="6" Padding="12"/>
                </StackPanel>
            </Border>

            <!-- Date Settings -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="期間設定" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>

                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="開始日" FontSize="12" Opacity="0.7"/>
                        <CalendarDatePicker Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4"
                                Visibility="{x:Bind ViewModel.IsAllDay, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="開始時刻" FontSize="12" Opacity="0.7"/>
                        <TimePicker Time="{x:Bind ViewModel.StartTime, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                        <TextBlock Text="終了日" FontSize="12" Opacity="0.7"/>
                        <CalendarDatePicker Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4"
                                Visibility="{x:Bind ViewModel.IsAllDay, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="終了時刻" FontSize="12" Opacity="0.7"/>
                        <TimePicker Time="{x:Bind ViewModel.EndTime, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="24">
                        <ToggleSwitch Header="終日" IsOn="{x:Bind ViewModel.IsAllDay, Mode=TwoWay}"
                                      OnContent="ON" OffContent="OFF"/>
                        <ToggleSwitch Header="期限モード" IsOn="{x:Bind ViewModel.IsDeadlineMode, Mode=TwoWay}"
                                      OnContent="ON" OffContent="OFF"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </Border>

            <!-- Subtasks -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="サブタスク" FontSize="13" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="＋ 追加" Click="AddSubtask_Click"
                                Padding="12,8" CornerRadius="6" Background="#0078D4" Foreground="White" BorderThickness="0"/>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Subtasks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubtaskViewModel">
                                <Border Background="#F8F8F8" CornerRadius="6" Margin="0,4" Padding="12"
                                        BorderBrush="#E8E8E8" BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="サブタスク名"
                                                 Background="#FFFFFF" BorderBrush="#E0E0E0" CornerRadius="4"/>
                                        <CalendarDatePicker Grid.Column="1" Date="{x:Bind StartDate, Mode=TwoWay}"/>
                                        <CalendarDatePicker Grid.Column="2" Date="{x:Bind EndDate, Mode=TwoWay}"/>
                                        <Button Grid.Column="3" Content="✕" Click="RemoveSubtask_Click"
                                                Background="Transparent" BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Memo -->
            <Border Background="#FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="メモ" FontSize="13" FontWeight="SemiBold" Foreground="#666666"/>
                    <TextBox Text="{x:Bind ViewModel.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                             PlaceholderText="メモを入力..."
                             Background="#FAFAFA" BorderBrush="#E0E0E0" CornerRadius="6" Padding="12"/>
                </StackPanel>
            </Border>

            <Button Content="作成" HorizontalAlignment="Left" MinWidth="120" Click="Create_Click"
                    Padding="16,10" CornerRadius="6" Background="#0078D4" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
